{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parsejudge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "enabled": true }, "traces": { "enabled": true } },
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["17 * * * *"] },
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "parsejudge_usage" }],
  "limits": { "cpu_ms": 300000 },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/blobs/*", "/openapi.json"]
  },
  "vars": {
    "PUBLIC_URL": "http://localhost:8787",
    "JUDGE_MODEL": "openai/gpt-6.1-sol",
    "SMALL_MODEL": "anthropic/claude-haiku-5.5",
    "JUDGE_REASONING_EFFORT": "medium",
    "JUDGE_BASE_URL": "https://openrouter.ai/api/v1",
    "MAX_PAGES_PER_RUN": "1000",
    "MAX_CONCURRENCY": "{}",
    "AWS_REGION": "us-west-2",
    "AUTH_MODE": "email",
    "EMAIL_FROM": "noreply@parsejudge.com"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "parsejudge", "database_id": "local", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "parsejudge-blobs" }],
  "durable_objects": {
    "bindings": [
      { "name": "RUN_EVENTS", "class_name": "RunEvents" },
      { "name": "PROVIDER_SLOTS", "class_name": "ProviderSlots" },
      { "name": "CONVERTER", "class_name": "Converter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunEvents", "ProviderSlots", "Converter"] }],
  // DOCX/PPTX -> PDF. parsejudge.com points `image` at its private Reducto-engine image instead.
  "containers": [
    {
      "class_name": "Converter",
      "image": "../../containers/libreoffice/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 4
    }
  ],
  "workflows": [
    { "name": "parsejudge-run", "binding": "RUN_WORKFLOW", "class_name": "RunWorkflow" },
    { "name": "parsejudge-page", "binding": "PAGE_WORKFLOW", "class_name": "PageWorkflow" }
  ]
}
